# Copy to .env and fill in. Never commit .env.

# Base domain for the CRM. Clients get <client>.CRM_DOMAIN, the login
# page lives at <DEFAULT_SUBDOMAIN>.CRM_DOMAIN (e.g. app.crm.re5agency.com).
CRM_DOMAIN=crm.re5agency.com
DEFAULT_SUBDOMAIN=app

# Image built by .github/workflows/re5-build-image.yaml. Pin TAG to a
# sha-<commit> tag to control exactly when a server upgrades.
RE5_IMAGE=ghcr.io/astral8o/twenty
TAG=latest

# HTTPS certificates (Let's Encrypt via Cloudflare DNS)
ACME_EMAIL=you@re5agency.com
# Cloudflare API token with Zone:DNS:Edit on the domain's zone
CLOUDFLARE_API_TOKEN=

# Database. Generate with: openssl rand -hex 32
PG_DATABASE_USER=postgres
PG_DATABASE_PASSWORD=
PG_DATABASE_NAME=default

# Generate with: openssl rand -base64 32
# Back this up somewhere safe: losing it makes stored credentials unreadable.
ENCRYPTION_KEY=
FALLBACK_ENCRYPTION_KEY=

# Email (invites, password resets). LOGGER only prints emails to the logs;
# set SMTP once you have a provider such as Resend or Postmark.
EMAIL_DRIVER=LOGGER
EMAIL_FROM_ADDRESS=crm@re5agency.com
EMAIL_FROM_NAME=Re5 CRM
EMAIL_SMTP_HOST=smtp.resend.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_USER=resend
EMAIL_SMTP_PASSWORD=

# How many days of nightly database dumps scripts/backup.sh keeps.
BACKUP_KEEP_DAYS=14
